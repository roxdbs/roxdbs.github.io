---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Accueil">
	<section class="hero">
		<p class="hero__eyebrow">
			Sciences cognitives appliquées · Conception centrée utilisateurs
		</p>
		<h1 class="hero__title">
			Comprendre le fonctionnement humain pour concevoir des solutions
			concrètes et adaptées pour le monde du travail.
		</h1>
		<p class="hero__subtitle">
			Etudiante en M2 Sciences cognitives pour l'entreprise
		</p>
		<p class="hero__status">
			<span aria-hidden="true">●</span> A la recherche d'un stage de 6 mois,
			dès janvier 2027
		</p>
		<div class="hero__actions">
			<a
				href="/cv-roxane-dubus.pdf"
				class="button button--primary"
				download
			>
				Télécharger mon CV (PDF)
			</a>
			<a
				href="mailto:roxane.dubus4@gmail.com"
				class="hero__quick-link"
				aria-label="M'écrire un e-mail"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					aria-hidden="true"
				>
					<rect x="3" y="5" width="18" height="14" rx="2"></rect>
					<path d="m4 7 8 6 8-6"></path>
				</svg>
			</a>
			<a
				href="https://www.linkedin.com/in/roxane-dubus-404545359"
				target="_blank"
				rel="noopener noreferrer"
				class="hero__quick-link"
				aria-label="Mon profil LinkedIn (nouvel onglet)"
			>
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3.5a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 20h-3.37v-5.6c0-1.34-.03-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V20H9.68V8.5h3.24v1.57h.05c.45-.85 1.56-1.75 3.2-1.75 3.42 0 4.05 2.25 4.05 5.18V20Z"
					></path>
				</svg>
			</a>
		</div>
	</section>

	<section class="section">
		<h2>Mon approche</h2>
		<p>
			À écrire : une ou deux phrases sur ma façon de travailler, reliées à
			un exemple concret.
		</p>
		<a href="/a-propos" class="button button--secondary">
			Découvrir mon parcours et mon approche
		</a>
	</section>

	<section class="section">
		<h2>Quelques projets</h2>
		<p>
			À remplacer par 2-3 cartes de projet (image, titre, une ligne de
			résultat).
		</p>
		<a href="/projets" class="button button--secondary">
			Voir tous les projets
		</a>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: var(--space-6) var(--space-6);
		max-width: 45rem;
		background-color: var(--color-bg-muted); /* beige clair */
		border-radius: var(--radius-md);
	}

	.hero__eyebrow {
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink);
		margin-bottom: var(--space-3);
	}

	.hero__title {
		max-width: 24ch;
		margin-bottom: var(--space-5);
		color: var(--color-accent);
	}

	.hero__subtitle {
		font-size: var(--text-lg);
		margin-bottom: var(--space-2);
	}

	.hero__status {
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}

	.hero__actions {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	.hero__quick-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1.5px solid var(--color-accent);
		border-radius: var(--radius-full);
		color: var(--color-accent);
		flex-shrink: 0;
		transition:
			background-color var(--duration-base) var(--ease-standard),
			color var(--duration-base) var(--ease-standard);
	}

	.hero__quick-link svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.hero__quick-link:hover,
	.hero__quick-link:focus-visible {
		background-color: var(--color-beige);
		color: var(--color-accent-hover);
	}

	.section {
		padding-block: var(--space-8);
		border-top: 1px solid var(--color-border);
	}

	/* Sur petit écran, les mêmes espaces fixes paraissent trop grands
     par rapport à la hauteur disponible : on les resserre. */
	@media (max-width: 30rem) {
		.hero {
			padding-block: var(--space-6);
		}
		.section {
			padding-block: var(--space-5);
		}
	}
</style>
