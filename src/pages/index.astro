---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import terImg from "../assets/projets/ter.png";
import mediationImg from "../assets/projets/mediation.jpg";
import refonteImg from "../assets/projets/refonte-site.png";
---

<BaseLayout title="Accueil">
	<div class="hero-zone">
		<section class="hero">
			<p class="hero__eyebrow">
				Sciences cognitives appliquées · Conception centrée sur l'humain
			</p>
			<h1 class="hero__title">
				Comprendre le fonctionnement humain pour concevoir des solutions
				concrètes et adaptées pour le monde du travail.
			</h1>
			<p class="hero__subtitle">
				Étudiante en M2 Sciences cognitives pour l'entreprise
			</p>
			<p class="hero__status">
				<span aria-hidden="true">●</span> À la recherche d'un stage de 6 mois,
				dès janvier 2027
			</p>
			<div class="hero__actions">
				<a
					href="/cv-roxane-dubus.pdf"
					class="button button--primary"
					target="_blank"
					rel="noopener noreferrer"
				>
					Consulter mon CV
					<span class="visually-hidden"
						>(s'ouvre dans un nouvel onglet)</span
					>
				</a>
				<a
					href="mailto:roxane.dubus4@gmail.com"
					class="hero__quick-link"
					aria-label="M'écrire un e-mail"
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						aria-hidden="true"
					>
						<rect x="3" y="5" width="18" height="14" rx="2"></rect>
						<path d="m4 7 8 6 8-6"></path>
					</svg>
				</a>
				<a
					href="https://www.linkedin.com/in/roxane-dubus-404545359"
					target="_blank"
					rel="noopener noreferrer"
					class="hero__quick-link"
					aria-label="Mon profil LinkedIn (nouvel onglet)"
				>
					<svg
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path
							d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3.5a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 20h-3.37v-5.6c0-1.34-.03-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V20H9.68V8.5h3.24v1.57h.05c.45-.85 1.56-1.75 3.2-1.75 3.42 0 4.05 2.25 4.05 5.18V20Z"
						></path>
					</svg>
				</a>
			</div>
		</section>

		<div class="featured">
			<h2 class="featured__label">Projets sélectionnés</h2>
			<ul class="featured__list">
				<li>
					<a href="/projets" class="featured__card">
						<Image
							src={mediationImg}
							alt=""
							width={240}
							height={180}
							densities={[1, 2]}
							loading="eager"
							class="featured__img"
						/>
						<span class="featured__name"
							>Stage M1 : dispositifs de médiation culturelle pour
							enfants</span
						>
					</a>
				</li>
				<li>
					<a href="/projets" class="featured__card">
						<Image
							src={refonteImg}
							alt=""
							width={240}
							height={180}
							densities={[1, 2]}
							loading="eager"
							class="featured__img"
						/>
						<span class="featured__name"
							>Stage M1 : refonte d'un site web</span
						>
					</a>
				</li>
				<li>
					<a href="/projets" class="featured__card">
						<Image
							src={terImg}
							alt=""
							width={240}
							height={180}
							densities={[1, 2]}
							loading="eager"
							class="featured__img"
						/>
						<span class="featured__name"
							>TER : application numérique vs papier-crayon</span
						>
					</a>
				</li>
			</ul>
		</div>
	</div>

	<section class="section approach">
		<div class="approach__text">
			<h2>Mon approche</h2>
			<p>
				Pour moi, les sciences cognitives appliquées servent à
				comprendre comment les gens perçoivent, décident et agissent,
				afin d'améliorer concrètement des situations réelles.
				<br />Deux axes m'intéressent :
			</p>
			<ul>
				<li>
					améliorer les façons de travailler dans les organisations
					(gestion de projet, travail en équipe, pratiques de travail)
				</li>
				<li>
					mieux concevoir des solutions en intégrant les besoins, les
					comportements et les capacités de leurs utilisatrices et
					utilisateurs.
				</li>
			</ul>
			<p>
				Je cherche un métier où cette démarche produit des résultats
				concrets et visibles, en ingénierie cognitive, en cognitique ou
				en UX Research.
			</p>
			<a href="/a-propos" class="button button--secondary">
				Découvrir mon parcours
			</a>
		</div>

		<!-- Emplacement du schéma Figma : à remplacer par l'image exportée -->
		<div class="approach__figure" aria-hidden="true">
			<img
				src="/images/illustration_approche.svg"
				width="412"
				height="256"
				alt=""
				loading="lazy"
			/>
		</div>
	</section>
</BaseLayout>

<style>
	.hero-zone {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 22rem;
		gap: var(--space-8);
		align-items: start;
	}

	.hero {
		padding: var(--space-6) var(--space-6);
		max-width: 45rem;
		background-color: var(--color-bg-muted); /* beige clair */
		border-radius: var(--radius-md);
	}

	.hero__eyebrow {
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink);
		margin-bottom: var(--space-3);
	}

	.hero__title {
		max-width: 24ch;
		margin-bottom: var(--space-5);
		color: var(--color-accent);
	}

	.hero__subtitle {
		font-size: var(--text-lg);
		margin-bottom: var(--space-2);
	}

	.hero__status {
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}

	.hero__actions {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	.hero__quick-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1.5px solid var(--color-accent);
		border-radius: var(--radius-full);
		color: var(--color-accent);
		flex-shrink: 0;
		transition:
			background-color var(--duration-base) var(--ease-standard),
			color var(--duration-base) var(--ease-standard);
	}

	.hero__quick-link svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.hero__quick-link:hover,
	.hero__quick-link:focus-visible {
		background-color: var(--color-beige);
		color: var(--color-accent-hover);
	}

	.section {
		padding-block: var(--space-8);
		border-top: 1px solid var(--color-border);
	}

	/* Sur petit écran, les mêmes espaces fixes paraissent trop grands
     par rapport à la hauteur disponible : on les resserre. */
	@media (max-width: 30rem) {
		.hero {
			padding-block: var(--space-6);
		}
		.section {
			padding-block: var(--space-5);
		}
	}

	.featured {
		padding-top: var(--space-6);
	}

	.featured__label {
		line-height: var(--leading-normal);
		margin: 0 0 var(--space-4);
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	.featured__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.featured__card {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-3);
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius-md);
		background-color: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
		transition:
			border-color var(--duration-fast),
			box-shadow var(--duration-fast);
	}

	.featured__card:hover {
		border-color: var(--color-accent);
		box-shadow: var(--shadow-md);
	}

	.featured__img {
		flex: none;
		width: 9rem;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: center;
		border-radius: var(--radius-sm);
		background-color: var(--color-bg-muted);
	}

	.featured__img--top {
		object-position: top;
	}

	.featured__name {
		text-wrap: balance;
		font-family: var(--font-heading);
		font-weight: 400;
		line-height: var(--leading-tight);
	}

	.featured__card:hover .featured__name {
		color: var(--color-accent);
		text-decoration: underline; /* pas seulement la couleur pour signaler le survol */
	}

	/* En dessous, le hero et la liste s'empilent (version mobile) */
	@media (max-width: 80rem) {
		.hero-zone {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.approach {
		display: grid;
		grid-template-columns: minmax(0, min(var(--measure), 60%)) minmax(
				0,
				1fr
			);
		gap: var(--space-8);
		align-items: center;
	}

	.approach__text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.approach__text > * {
		margin-block: 0;
	}

	.approach__figure {
		border: 2.5px solid var(--color-accent);
		border-radius: 40% / 35%;
		padding: 0 var(--space-3) var(--space-3);
	}

	/* En dessous de cette largeur, on empile : texte d'abord, schéma ensuite */
	@media (max-width: 48rem) {
		.approach {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
