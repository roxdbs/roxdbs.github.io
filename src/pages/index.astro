---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Accueil">
	<section class="hero">
		<p class="hero__eyebrow">
			Sciences cognitives appliquées · Conception centrée utilisateurs
		</p>
		<h1 class="hero__title">
			Comprendre le fonctionnement humain pour concevoir des solutions
			concrètes et adaptées pour le monde du travail.
		</h1>
		<p class="hero__subtitle">
			Etudiante en M2 Sciences cognitives pour l'entreprise
		</p>
		<p class="hero__status">
			<span aria-hidden="true">●</span> A la recherche d'un stage de 6 mois,
			dès janvier 2027
		</p>
		<a href="/cv-roxane-dubus.pdf" class="button button--primary" download>
			Télécharger mon CV (PDF)
		</a>
	</section>

	<section class="section">
		<h2>Mon approche</h2>
		<p>
			À écrire : une ou deux phrases sur ma façon de travailler, reliées à
			un exemple concret.
		</p>
		<a href="/a-propos" class="button button--secondary">
			Découvrir mon parcours et mon approche
		</a>
	</section>

	<section class="section">
		<h2>Projets</h2>
		<p>
			À remplacer par 2-3 cartes de projet (image, titre, une ligne de
			résultat).
		</p>
		<a href="/projets" class="button button--secondary">
			Voir tous les projets
		</a>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: var(--space-10);
		max-width: 42rem;
	}

	.hero__eyebrow {
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink);
		margin-bottom: var(--space-3);
	}

	.hero__title {
		margin-bottom: var(--space-5);
		color: var(--color-accent);
	}

	.hero__subtitle {
		font-size: var(--text-lg);
		margin-bottom: var(--space-2);
	}

	.hero__status {
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}

	.section {
		padding-block: var(--space-8);
		border-top: 1px solid var(--color-border);
	}

	/* Sur petit écran, les mêmes espaces fixes paraissent trop grands
     par rapport à la hauteur disponible : on les resserre. */
	@media (max-width: 30rem) {
		.hero {
			padding-block: var(--space-6);
		}
		.section {
			padding-block: var(--space-5);
		}
	}
</style>
