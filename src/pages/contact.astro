---
import BaseLayout from "../layouts/BaseLayout.astro";
const email = "roxane.dubus4@gmail.com";
const linkedin = "https://www.linkedin.com/in/roxane-dubus-404545359";
const phoneHref = "+33788097848";
---

<BaseLayout
    title="Me contacter"
    description="Contacter Roxane Dubus par e-mail ou LinkedIn."
>
    <section class="section">
        <h1>Me contacter</h1>
        <p class="spaced">
            Pour en apprendre davantage sur moi et sur mon parcours, n'hésitez
            pas à me contacter. <br />Je suis ouverte pour répondre à vos
            questions.
        </p>
        <div class="button_div">
            <a href={`mailto:${email}`} class="button button--primary">
                M'écrire un e-mail
            </a>
            <a
                href={linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="button button--secondary"
            >
                Me contacter sur LinkedIn
                <span class="visually-hidden"
                    >(s'ouvre dans un nouvel onglet)</span
                >
            </a>
        </div>
    </section>
</BaseLayout>
